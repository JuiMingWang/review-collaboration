  "cards": [
    {
      "title": "What the host needs",
      "items": [
        "Account for every decision-changing question and objection; merged duplicates must not hide unresolved issues.",
        "Hashes cannot prove semantic completeness; missing context may still require original material.",
        "The final report also retains material disagreement; agreeing is not required."
      ],
      "dot": "cyan"
    },
    {
      "title": "Maintenance is a separate request",
      "items": [
        "No extra per-run evaluation or automatic skill edit. Use 07 only when the user requests maintenance.",
        "Communication authority does not authorize edits or publication. A note revision conflict cannot be overwritten."
      ],
      "dot": "amber"
    }
  ]
