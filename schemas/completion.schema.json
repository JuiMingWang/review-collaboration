{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "completion.schema.json",
  "title": "completion.json（ended 的唯一權威證據）",
  "description": "設計依據：diagnostic snapshot 第 13 節 Step 5 決定 1 第 8 點與跨 Step 決定 1。驗證所有必要 hash 後最後寫入；有效 marker 出現後才能刪 active。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "ended_reason", "final_package_ref", "required_artifacts", "completed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "review_id": { "type": "string", "minLength": 1 },
    "ended_reason": { "type": "string", "enum": ["consensus-finalized", "user-arbitrated-closed", "abandoned", "superseded"] },
    "final_package_ref": {
      "oneOf": [
        { "type": "null", "description": "abandoned／superseded 未走到 CONSENSUS 時可為 null。" },
        { "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
      ]
    },
    "handoff_ref": {
      "oneOf": [ { "type": "null" }, { "type": "object", "required": ["path", "sha256"], "properties": { "path": {"type":"string"}, "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"} } } ]
    },
    "required_artifacts": {
      "description": "history bundle 中每個被 final package／handoff／ledger 傳遞引用的 immutable artifact，路徑＋完整 SHA-256。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256"],
        "properties": {
          "relative_path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "ended_reason": { "const": "consensus-finalized" } } },
      "then": { "required": ["final_package_ref", "handoff_ref"],
                "properties": { "final_package_ref": { "type": "object" }, "handoff_ref": { "type": "object" } } } }
  ]
}
